<?xml version="1.0" encoding="utf-8"?>
<!-- Settings home, Figma 54:245 (design/figma/00_54-245_app-settings.png). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/likhibi_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textColor="@color/app_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/app_text_subtitle"
            android:textSize="14sp" />

        <View
            android:layout_width="86dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/shawl_band"
            android:importantForAccessibility="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enable_keyboard"
            style="@style/Likhibi.Button.Filled"
            android:layout_marginTop="23dp"
            android:text="@string/btn_enable" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_keyboard"
            style="@style/Likhibi.Button.Outlined"
            android:layout_marginTop="20dp"
            android:text="@string/btn_select" />

        <!-- PERSONALIZATION -->
        <TextView
            style="@style/Likhibi.SectionHeader"
            android:layout_marginTop="32dp"
            android:text="@string/section_personalization" />

        <com.google.android.material.card.MaterialCardView style="@style/Likhibi.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Opens the theme gallery (screen 8). -->
                <LinearLayout
                    android:id="@+id/row_theme"
                    style="@style/Likhibi.Row"
                    android:background="@drawable/app_row_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="72dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Likhibi.RowTitle"
                            android:text="@string/row_theme" />

                        <TextView
                            style="@style/Likhibi.RowDescription"
                            android:text="@string/row_theme_desc" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_theme_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/app_text"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_kb_chevron_right"
                        app:tint="@color/app_text" />
                </LinearLayout>

                <View style="@style/Likhibi.Divider" />

                <LinearLayout
                    style="@style/Likhibi.Row"
                    android:minHeight="69dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Likhibi.RowTitle"
                            android:text="@string/row_font" />

                        <TextView
                            style="@style/Likhibi.RowDescription"
                            android:text="@string/row_font_desc" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_font"
                        style="@style/Likhibi.Select"
                        android:contentDescription="@string/row_font" />
                </LinearLayout>

                <View style="@style/Likhibi.Divider" />

                <!-- Opens Preferences (screen 10), where the on/off switches live. -->
                <LinearLayout
                    android:id="@+id/row_more_preferences"
                    style="@style/Likhibi.Row"
                    android:background="@drawable/app_row_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="69dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Likhibi.RowTitle"
                            android:text="@string/row_more_preferences" />

                        <TextView
                            style="@style/Likhibi.RowDescription"
                            android:text="@string/row_more_preferences_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_kb_chevron_right"
                        app:tint="@color/app_text" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SENSORY FEEDBACK: strength and volume. Switching them on and off is in Preferences. -->
        <TextView
            style="@style/Likhibi.SectionHeader"
            android:text="@string/section_feedback" />

        <com.google.android.material.card.MaterialCardView style="@style/Likhibi.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Likhibi.RowTitle"
                        android:text="@string/row_haptic" />

                    <TextView
                        android:id="@+id/lbl_haptic"
                        style="@style/Likhibi.RowDescription" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/seek_haptic"
                        style="@style/Likhibi.Slider"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/row_haptic"
                        android:stepSize="1"
                        android:valueFrom="1"
                        android:valueTo="50" />
                </LinearLayout>

                <View style="@style/Likhibi.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Likhibi.RowTitle"
                        android:text="@string/row_sound" />

                    <TextView
                        android:id="@+id/lbl_sound_volume"
                        style="@style/Likhibi.RowDescription" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/seek_sound_volume"
                        style="@style/Likhibi.Slider"
                        android:layout_marginTop="6dp"
                        android:contentDescription="@string/row_sound_volume"
                        android:stepSize="1"
                        android:valueFrom="0"
                        android:valueTo="100" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TRANSLATION (not in the design; keeps the existing translation controls) -->
        <TextView
            style="@style/Likhibi.SectionHeader"
            android:text="@string/section_translation" />

        <com.google.android.material.card.MaterialCardView style="@style/Likhibi.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Likhibi.Row"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Likhibi.RowTitle"
                        android:text="@string/row_offline_translator" />

                    <TextView
                        android:id="@+id/text_translate_model_status"
                        style="@style/Likhibi.RowDescription"
                        android:text="Checking…" />
                </LinearLayout>

                <View style="@style/Likhibi.Divider" />

                <LinearLayout style="@style/Likhibi.Row">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Likhibi.RowTitle"
                            android:text="@string/row_translate_online" />

                        <TextView
                            style="@style/Likhibi.RowDescription"
                            android:text="@string/row_translate_online_desc" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_translate_online"
                        style="@style/Likhibi.Switch"
                        android:contentDescription="@string/row_translate_online" />
                </LinearLayout>

                <View style="@style/Likhibi.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="19dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/Likhibi.RowTitle"
                        android:text="@string/row_server" />

                    <EditText
                        android:id="@+id/edit_translate_server"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/app_outline"
                        android:hint="https://… or http://192.168.1.5:8000"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="@color/app_text"
                        android:textColorHint="@color/app_text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/Likhibi.RowDescription"
                    android:layout_width="match_parent"
                    android:layout_marginTop="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="19dp"
                    android:paddingBottom="14dp"
                    android:text="@string/translate_privacy_note" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TOOLS -->
        <TextView
            style="@style/Likhibi.SectionHeader"
            android:text="@string/section_tools" />

        <com.google.android.material.card.MaterialCardView style="@style/Likhibi.Card">

            <LinearLayout
                android:id="@+id/btn_clear_clipboard"
                style="@style/Likhibi.Row"
                android:background="@drawable/app_row_background"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    style="@style/Likhibi.RowTitle"
                    android:text="@string/row_clear_clipboard"
                    android:textColor="@color/app_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
