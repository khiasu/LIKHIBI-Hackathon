<?xml version="1.0" encoding="utf-8"?>
<!-- The keyboard window. The key grid (KeyboardView), the popup overlay and the panels are
     added in code by LikhibiImeService; colours come from KeyboardTheme. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/ime_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- One-handed mode (keys on the right): the controls take the left. -->
        <LinearLayout
            android:id="@+id/one_hand_left"
            style="@style/Likhibi.Keyboard.OneHandColumn">

            <ImageView
                android:id="@+id/one_hand_left_exit"
                style="@style/Likhibi.Keyboard.OneHandButton"
                android:contentDescription="Full-width keyboard"
                android:src="@drawable/ic_kb_maximize" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/one_hand_left_move"
                style="@style/Likhibi.Keyboard.OneHandSwap"
                android:contentDescription="Move keyboard to the left"
                android:src="@drawable/ic_kb_chevron_left" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="100"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/strip_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Suggestions: tools button, then three suggestions, the likeliest in the middle. -->
                <LinearLayout
                    android:id="@+id/suggestion_strip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btn_toolbar_toggle"
                        style="@style/Likhibi.Keyboard.StripButton"
                        android:contentDescription="Show tools"
                        android:src="@drawable/ic_kb_layout_grid" />

                    <TextView
                        android:id="@+id/suggestion_1"
                        style="@style/Likhibi.Keyboard.Suggestion" />

                    <View
                        android:id="@+id/suggestion_divider_1"
                        android:layout_width="1dp"
                        android:layout_height="20dp" />

                    <TextView
                        android:id="@+id/suggestion_2"
                        style="@style/Likhibi.Keyboard.Suggestion" />

                    <View
                        android:id="@+id/suggestion_divider_2"
                        android:layout_width="1dp"
                        android:layout_height="20dp" />

                    <TextView
                        android:id="@+id/suggestion_3"
                        style="@style/Likhibi.Keyboard.Suggestion" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="1dp" />
                </LinearLayout>

                <!-- Tools, icons only as on Gboard. Same height as the suggestions. -->
                <LinearLayout
                    android:id="@+id/toolbar_strip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/btn_toolbar_back"
                        style="@style/Likhibi.Keyboard.StripButton"
                        android:contentDescription="Show suggestions"
                        android:src="@drawable/ic_kb_chevron_left" />

                    <ImageView
                        android:id="@+id/tool_emoji"
                        style="@style/Likhibi.Keyboard.ToolButton"
                        android:contentDescription="Emoji"
                        android:src="@drawable/ic_kb_smile" />

                    <ImageView
                        android:id="@+id/tool_clipboard"
                        style="@style/Likhibi.Keyboard.ToolButton"
                        android:contentDescription="Clipboard"
                        android:src="@drawable/ic_kb_clipboard" />

                    <ImageView
                        android:id="@+id/tool_translate"
                        style="@style/Likhibi.Keyboard.ToolButton"
                        android:contentDescription="Translate"
                        android:src="@drawable/ic_kb_languages" />

                    <ImageView
                        android:id="@+id/tool_themes"
                        style="@style/Likhibi.Keyboard.ToolButton"
                        android:contentDescription="Themes"
                        android:src="@drawable/ic_kb_palette" />

                    <ImageView
                        android:id="@+id/tool_one_hand"
                        style="@style/Likhibi.Keyboard.ToolButton"
                        android:contentDescription="One-handed mode"
                        android:src="@drawable/ic_kb_hand" />

                    <ImageView
                        android:id="@+id/tool_settings"
                        style="@style/Likhibi.Keyboard.ToolButton"
                        android:contentDescription="Keyboard settings"
                        android:src="@drawable/ic_kb_settings" />
                </LinearLayout>

                <!-- Translate: direction, the translation, and what to do with it. -->
                <LinearLayout
                    android:id="@+id/translate_strip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/translate_segments"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:orientation="horizontal"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/translate_seg_en_nag"
                                style="@style/Likhibi.Keyboard.Segment"
                                android:text="English → Nagamese" />

                            <TextView
                                android:id="@+id/translate_seg_nag_en"
                                style="@style/Likhibi.Keyboard.Segment"
                                android:layout_marginStart="2dp"
                                android:text="Nagamese → English" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:id="@+id/translate_close"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="Close translate"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_kb_x" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/translate_card"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/translate_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="3"
                            android:text="Translating…"
                            android:textSize="13sp" />

                        <View
                            android:id="@+id/translate_bar_1"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="8dp" />

                        <View
                            android:id="@+id/translate_bar_2"
                            android:layout_width="180dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/translate_result"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="2"
                            android:textSize="17sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/translate_source"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/translate_source_icon"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_kb_wifi_off" />

                            <TextView
                                android:id="@+id/translate_source_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:includeFontPadding="false"
                                android:text="Offline · Likhibi"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/translate_undo"
                            style="@style/Likhibi.Keyboard.GhostButton"
                            android:contentDescription="Undo">

                            <ImageView
                                android:id="@+id/translate_undo_icon"
                                style="@style/Likhibi.Keyboard.GhostIcon"
                                android:src="@drawable/ic_kb_undo" />

                            <TextView
                                android:id="@+id/translate_undo_text"
                                style="@style/Likhibi.Keyboard.GhostLabel"
                                android:text="Undo" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/translate_copy"
                            style="@style/Likhibi.Keyboard.GhostButton"
                            android:contentDescription="Copy translation">

                            <ImageView
                                android:id="@+id/translate_copy_icon"
                                style="@style/Likhibi.Keyboard.GhostIcon"
                                android:src="@drawable/ic_kb_copy" />

                            <TextView
                                android:id="@+id/translate_copy_text"
                                style="@style/Likhibi.Keyboard.GhostLabel"
                                android:text="Copy" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/translate_online"
                            style="@style/Likhibi.Keyboard.GhostButton"
                            android:contentDescription="Translate with the Likhibi server"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/translate_online_icon"
                                style="@style/Likhibi.Keyboard.GhostIcon"
                                android:src="@drawable/ic_kb_wifi" />

                            <TextView
                                android:id="@+id/translate_online_text"
                                style="@style/Likhibi.Keyboard.GhostLabel"
                                android:text="Online" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/translate_replace"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:minWidth="64dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Replace"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- The key grid goes here; panels take its place (and the strip's). -->
            <FrameLayout
                android:id="@+id/keys_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- One-handed mode (keys on the left): the controls take the right. -->
        <LinearLayout
            android:id="@+id/one_hand_right"
            style="@style/Likhibi.Keyboard.OneHandColumn">

            <ImageView
                android:id="@+id/one_hand_right_exit"
                style="@style/Likhibi.Keyboard.OneHandButton"
                android:contentDescription="Full-width keyboard"
                android:src="@drawable/ic_kb_maximize" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/one_hand_right_move"
                style="@style/Likhibi.Keyboard.OneHandSwap"
                android:contentDescription="Move keyboard to the right"
                android:src="@drawable/ic_kb_chevron_right" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
