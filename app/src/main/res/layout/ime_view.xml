<?xml version="1.0" encoding="utf-8"?>
<!-- The keyboard: a strip (suggestions, tools or translate) over the keys, plus a layer for
     key previews and long-press popups. Colours are set from KeyboardTheme in code.
     Geometry from design/SPECS.md, screens 1-4. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/ime_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/strip_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Suggestions (21:632): tools toggle, then three suggestions split by thin dividers. -->
            <LinearLayout
                android:id="@+id/suggestion_strip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/btn_toolbar_toggle"
                    android:layout_width="40dp"
                    android:layout_height="46dp"
                    android:contentDescription="Show tools"
                    android:paddingStart="10dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_kb_layout_grid" />

                <TextView
                    android:id="@+id/suggestion_1"
                    style="@style/Likhibi.Keyboard.Suggestion" />

                <View
                    android:id="@+id/suggestion_divider_1"
                    android:layout_width="1dp"
                    android:layout_height="22dp" />

                <TextView
                    android:id="@+id/suggestion_2"
                    style="@style/Likhibi.Keyboard.Suggestion" />

                <View
                    android:id="@+id/suggestion_divider_2"
                    android:layout_width="1dp"
                    android:layout_height="22dp" />

                <TextView
                    android:id="@+id/suggestion_3"
                    style="@style/Likhibi.Keyboard.Suggestion" />
            </LinearLayout>

            <!-- Toolbar (26:882): back, then six tools. Same height as the suggestions so nothing jumps. -->
            <LinearLayout
                android:id="@+id/toolbar_strip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btn_toolbar_back"
                    android:layout_width="40dp"
                    android:layout_height="46dp"
                    android:contentDescription="Hide tools"
                    android:paddingStart="10dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_kb_chevron_left" />

                <LinearLayout
                    android:id="@+id/tool_emoji"
                    style="@style/Likhibi.Keyboard.Tool"
                    android:contentDescription="Emoji">

                    <ImageView
                        android:id="@+id/icon_tool_emoji"
                        style="@style/Likhibi.Keyboard.ToolIcon"
                        android:src="@drawable/ic_kb_smile" />

                    <TextView
                        android:id="@+id/text_tool_emoji"
                        style="@style/Likhibi.Keyboard.ToolLabel"
                        android:text="Emoji" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tool_clipboard"
                    style="@style/Likhibi.Keyboard.Tool"
                    android:contentDescription="Clipboard">

                    <ImageView
                        android:id="@+id/icon_tool_clipboard"
                        style="@style/Likhibi.Keyboard.ToolIcon"
                        android:src="@drawable/ic_kb_clipboard" />

                    <TextView
                        android:id="@+id/text_tool_clipboard"
                        style="@style/Likhibi.Keyboard.ToolLabel"
                        android:text="Clipboard" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tool_translate"
                    style="@style/Likhibi.Keyboard.Tool"
                    android:contentDescription="Translate">

                    <ImageView
                        android:id="@+id/icon_tool_translate"
                        style="@style/Likhibi.Keyboard.ToolIcon"
                        android:src="@drawable/ic_kb_languages" />

                    <TextView
                        android:id="@+id/text_tool_translate"
                        style="@style/Likhibi.Keyboard.ToolLabel"
                        android:text="Translate" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tool_themes"
                    style="@style/Likhibi.Keyboard.Tool"
                    android:contentDescription="Themes">

                    <ImageView
                        android:id="@+id/icon_tool_themes"
                        style="@style/Likhibi.Keyboard.ToolIcon"
                        android:src="@drawable/ic_kb_palette" />

                    <TextView
                        android:id="@+id/text_tool_themes"
                        style="@style/Likhibi.Keyboard.ToolLabel"
                        android:text="Themes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tool_one_hand"
                    style="@style/Likhibi.Keyboard.Tool"
                    android:contentDescription="One-handed mode">

                    <ImageView
                        android:id="@+id/icon_tool_one_hand"
                        style="@style/Likhibi.Keyboard.ToolIcon"
                        android:src="@drawable/ic_kb_hand" />

                    <TextView
                        android:id="@+id/text_tool_one_hand"
                        style="@style/Likhibi.Keyboard.ToolLabel"
                        android:text="One hand" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tool_settings"
                    style="@style/Likhibi.Keyboard.Tool"
                    android:contentDescription="Settings">

                    <ImageView
                        android:id="@+id/icon_tool_settings"
                        style="@style/Likhibi.Keyboard.ToolIcon"
                        android:src="@drawable/ic_kb_settings" />

                    <TextView
                        android:id="@+id/text_tool_settings"
                        style="@style/Likhibi.Keyboard.ToolLabel"
                        android:text="Settings" />
                </LinearLayout>
            </LinearLayout>

            <!-- Translate (27:1188): direction, preview card, actions. One height for every
                 state, so the keyboard does not jump while a translation arrives. -->
            <LinearLayout
                android:id="@+id/translate_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/translate_segments"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/translate_seg_en_nag"
                            style="@style/Likhibi.Keyboard.Segment"
                            android:text="English → Nagamese" />

                        <TextView
                            android:id="@+id/translate_seg_nag_en"
                            style="@style/Likhibi.Keyboard.Segment"
                            android:layout_marginStart="2dp"
                            android:text="Nagamese → English" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/translate_close"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="-6dp"
                        android:contentDescription="Close translate"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_kb_x" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/translate_card"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/translate_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="3"
                        android:text="Translating…"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/translate_bar_1"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp" />

                    <View
                        android:id="@+id/translate_bar_2"
                        android:layout_width="210dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/translate_result"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="2"
                        android:textSize="18sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/translate_source"
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/translate_source_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_kb_wifi_off" />

                        <TextView
                            android:id="@+id/translate_source_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:includeFontPadding="false"
                            android:text="Offline · Likhibi"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/translate_undo"
                        style="@style/Likhibi.Keyboard.GhostButton"
                        android:contentDescription="Undo">

                        <ImageView
                            android:id="@+id/translate_undo_icon"
                            style="@style/Likhibi.Keyboard.GhostIcon"
                            android:src="@drawable/ic_kb_undo" />

                        <TextView
                            android:id="@+id/translate_undo_text"
                            style="@style/Likhibi.Keyboard.GhostLabel"
                            android:text="Undo" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/translate_copy"
                        style="@style/Likhibi.Keyboard.GhostButton"
                        android:contentDescription="Copy translation">

                        <ImageView
                            android:id="@+id/translate_copy_icon"
                            style="@style/Likhibi.Keyboard.GhostIcon"
                            android:src="@drawable/ic_kb_copy" />

                        <TextView
                            android:id="@+id/translate_copy_text"
                            style="@style/Likhibi.Keyboard.GhostLabel"
                            android:text="Copy" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/translate_online"
                        style="@style/Likhibi.Keyboard.GhostButton"
                        android:contentDescription="Translate with the Likhibi server"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/translate_online_icon"
                            style="@style/Likhibi.Keyboard.GhostIcon"
                            android:src="@drawable/ic_kb_wifi" />

                        <TextView
                            android:id="@+id/translate_online_text"
                            style="@style/Likhibi.Keyboard.GhostLabel"
                            android:text="Online" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/translate_replace"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="48dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Replace"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/keys_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- One-handed mode: controls on the side away from the keys. -->
            <LinearLayout
                android:id="@+id/one_hand_left"
                style="@style/Likhibi.Keyboard.OneHandColumn">

                <ImageView
                    android:id="@+id/one_hand_left_move"
                    style="@style/Likhibi.Keyboard.OneHandButton"
                    android:contentDescription="Move keys to the other side"
                    android:src="@drawable/ic_kb_arrow_left_right" />

                <ImageView
                    android:id="@+id/one_hand_left_exit"
                    style="@style/Likhibi.Keyboard.OneHandButton"
                    android:contentDescription="Turn off one-handed mode"
                    android:src="@drawable/ic_kb_maximize" />
            </LinearLayout>

            <com.likhibi.android.CustomKeyboardView
                android:id="@+id/keyboard_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/one_hand_right"
                style="@style/Likhibi.Keyboard.OneHandColumn">

                <ImageView
                    android:id="@+id/one_hand_right_move"
                    style="@style/Likhibi.Keyboard.OneHandButton"
                    android:contentDescription="Move keys to the other side"
                    android:src="@drawable/ic_kb_arrow_left_right" />

                <ImageView
                    android:id="@+id/one_hand_right_exit"
                    style="@style/Likhibi.Keyboard.OneHandButton"
                    android:contentDescription="Turn off one-handed mode"
                    android:src="@drawable/ic_kb_maximize" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/popup_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:importantForAccessibility="noHideDescendants" />
</FrameLayout>
