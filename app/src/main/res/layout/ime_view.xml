<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1F22"
    android:orientation="vertical"
    android:paddingBottom="2dp">

    <!-- Professional Suggestion & Quick Action Bar -->
    <LinearLayout
        android:id="@+id/suggestion_bar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#1E1F22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:elevation="3dp">

        <!-- Dynamic Menu / Close Toggle Button (Likhibi App Logo background-less) -->
        <ImageView
            android:id="@+id/btn_toolbar_toggle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/likhibi_logo"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <!-- Vertical Separator -->
        <View
            android:id="@+id/toolbar_divider"
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="2dp"
            android:background="#2B2D31" />

        <!-- 1. Suggestions Container (Visible by default) -->
        <LinearLayout
            android:id="@+id/suggestions_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- Suggestion 1 (Left) -->
            <TextView
                android:id="@+id/suggestion_1"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:textColor="#949BA4"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Fine vertical separator 1 -->
            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#2B2D31" />

            <!-- Suggestion 2 (Center Highlight) -->
            <TextView
                android:id="@+id/suggestion_2"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.2"
                android:layout_marginHorizontal="6dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:textColor="#6BA0F5"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Fine vertical separator 2 -->
            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#2B2D31" />

            <!-- Suggestion 3 (Right) -->
            <TextView
                android:id="@+id/suggestion_3"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:textColor="#949BA4"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- 2. Keyboard Utility Tools Container (Hidden by default) -->
        <LinearLayout
            android:id="@+id/tools_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <!-- Translate Button: English <-> Nagamese, on the phone -->
            <LinearLayout
                android:id="@+id/btn_tool_translate"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.15"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icon_tool_translate"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_tool_translate"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/text_tool_translate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Translate"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Clipboard Button -->
            <LinearLayout
                android:id="@+id/btn_tool_clip"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icon_tool_clip"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_tool_clipboard"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/text_tool_clip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clipboard"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Themes Button -->
            <LinearLayout
                android:id="@+id/btn_tool_theme"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icon_tool_theme"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_tool_theme"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/text_tool_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Themes"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Settings Button -->
            <LinearLayout
                android:id="@+id/btn_tool_settings"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icon_tool_settings"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_tool_settings"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:id="@+id/text_tool_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

        </LinearLayout>

        <!-- 3. Translate strip (Hidden by default): direction, live preview, Online/Undo, Insert -->
        <LinearLayout
            android:id="@+id/translate_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/translate_direction"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="EN → NAG"
                android:textColor="#C62828"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Change translation direction" />

            <LinearLayout
                android:id="@+id/translate_preview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/translate_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#78716C"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Type a sentence" />

                <TextView
                    android:id="@+id/translate_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1C1917"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="start" />
            </LinearLayout>

            <TextView
                android:id="@+id/translate_action"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="#C62828"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/translate_insert"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_check_clean"
                app:tint="#C62828"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Insert translation" />
        </LinearLayout>

    </LinearLayout>

    <!-- Sleek premium thin divider under suggestion bar -->
    <View
        android:id="@+id/bar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2B2D31" />

    <!-- Our high-performance programmatically styled custom keyboard view -->
    <com.likhibi.android.CustomKeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
